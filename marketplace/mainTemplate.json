{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appName": {
      "type": "string",
      "metadata": {
        "description": "Globally unique site name"
      }
    },
    "image": {
      "type": "string",
      "defaultValue": "REGISTRY/azure-recall:1.0"
    },
    "openAiEndpoint": {
      "type": "string",
      "defaultValue": ""
    },
    "openAiKey": {
      "type": "securestring",
      "defaultValue": ""
    },
    "openAiDeployment": {
      "type": "string",
      "defaultValue": ""
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "recallApiKey": {
      "type": "securestring",
      "metadata": {
        "description": "Key agents and editors must send as x-api-key"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2022-09-01",
      "name": "[concat(parameters('appName'),'-plan')]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "sku": {
        "name": "B1"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2022-09-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux,container",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', concat(parameters('appName'),'-plan'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', concat(parameters('appName'),'-plan'))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "[concat('DOCKER|', parameters('image'))]",
          "appSettings": [
            {
              "name": "WEBSITES_PORT",
              "value": "8000"
            },
            {
              "name": "WEBSITES_ENABLE_APP_SERVICE_STORAGE",
              "value": "true"
            },
            {
              "name": "KB_DIR",
              "value": "/home/kb"
            },
            {
              "name": "AZURE_OPENAI_ENDPOINT",
              "value": "[parameters('openAiEndpoint')]"
            },
            {
              "name": "AZURE_OPENAI_KEY",
              "value": "[parameters('openAiKey')]"
            },
            {
              "name": "AZURE_OPENAI_DEPLOYMENT",
              "value": "[parameters('openAiDeployment')]"
            },
            {
              "name": "RECALL_API_KEY",
              "value": "[parameters('recallApiKey')]"
            },
            {
              "name": "AUTH_MODE",
              "value": "entra"
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "url": {
      "type": "string",
      "value": "[concat('https://', reference(parameters('appName')).defaultHostName)]"
    },
    "principalId": {
      "type": "string",
      "value": "[reference(parameters('appName'), '2022-09-01', 'Full').identity.principalId]"
    },
    "mcpUrl": {
      "type": "string",
      "value": "[concat('https://', reference(parameters('appName')).defaultHostName, '/mcp')]"
    }
  }
}